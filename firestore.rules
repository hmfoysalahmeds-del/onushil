rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isNotBlocked(userId) {
      return !exists(/databases/$(database)/documents/users/$(userId)) ||
             get(/databases/$(database)/documents/users/$(userId)).data.blocked != true;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'role', 'blocked']) &&
             data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
             data.uid == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 150 &&
             data.role in ['student', 'admin'] &&
             data.blocked is bool &&
             (!('photo' in data) || (data.photo is string && data.photo.size() <= 1000)) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 50)) &&
             (!('showOnLeaderboard' in data) || (data.showOnLeaderboard is bool));
    }

    function isValidExamHistory(data) {
      return data.keys().hasAll(['id', 'uid', 'score', 'totalQuestions', 'timeTakenSeconds']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
             data.uid == request.auth.uid &&
             data.score is number && data.score >= 0 &&
             data.totalQuestions is number && data.totalQuestions > 0 &&
             data.timeTakenSeconds is number && data.timeTakenSeconds >= 0;
    }

    function isValidLeaderboard(data) {
      return data.keys().hasAll(['uid', 'displayName', 'testType', 'score', 'total', 'accuracy', 'timeTaken', 'hidden']) &&
             data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
             data.uid == request.auth.uid &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 50 &&
             data.testType in ['verbal', 'non-verbal'] &&
             data.score is number && data.score >= 0 && data.score <= 200 &&
             data.total is number && data.total > 0 && data.total <= 200 &&
             data.accuracy is number && data.accuracy >= 0 && data.accuracy <= 100 &&
             data.timeTaken is number && data.timeTaken > 0 && data.timeTaken <= 7200 &&
             data.hidden is bool &&
             (!('photo' in data) || (data.photo is string && data.photo.size() <= 1000)) &&
             (!('setName' in data) || (data.setName is string && data.setName.size() <= 50)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 60));
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'hmfoysalahmeds@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isValidWatWord(data) {
      return data.keys().hasAll(['word', 'active']) &&
             data.word is string && data.word.size() > 0 && data.word.size() <= 100 &&
             data.active is bool &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 60));
    }

    function isValidWatAttempt(data) {
      return data.keys().hasAll(['id', 'uid', 'mode', 'date', 'words', 'completed']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
             data.uid == request.auth.uid &&
             data.mode in ['type', 'paper'] &&
             data.date is string && data.date.size() <= 60 &&
             data.words is list && data.words.size() <= 80 &&
             data.completed is bool &&
             (!('sentences' in data) || (data.sentences is list && data.sentences.size() <= 80)) &&
             (!('answeredCount' in data) || (data.answeredCount is number && data.answeredCount >= 0 && data.answeredCount <= 80)) &&
             (!('totalWords' in data) || (data.totalWords is number && data.totalWords <= 80));
    }

    // User profile document
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false; // Blanket user listing forbidden for PII security

      allow create: if isValidId(userId) &&
                       isOwner(userId) &&
                       isValidUser(request.resource.data) &&
                       (request.resource.data.role == 'student' || (request.resource.data.role == 'admin' && request.auth.token.email == 'hmfoysalahmeds@gmail.com')) &&
                       request.resource.data.blocked == false;

      allow update: if isValidId(userId) &&
                       isOwner(userId) &&
                       isValidUser(request.resource.data) &&
                       (request.resource.data.role == resource.data.role || (request.resource.data.role == 'admin' && request.auth.token.email == 'hmfoysalahmeds@gmail.com')) &&
                       request.resource.data.blocked == resource.data.blocked;

      allow delete: if false;

      // Candidate private exam history
      match /history/{historyId} {
        allow get, list: if isValidId(userId) && isOwner(userId);

        allow create: if isValidId(userId) &&
                         isOwner(userId) &&
                         isNotBlocked(userId) &&
                         isValidExamHistory(request.resource.data);

        allow update, delete: if isValidId(userId) && isOwner(userId);
      }

      // Candidate private Word Association Test history
      match /watHistory/{attemptId} {
        allow get, list: if isValidId(userId) && isOwner(userId);

        allow create, update: if isValidId(userId) &&
                                 isOwner(userId) &&
                                 isNotBlocked(userId) &&
                                 isValidWatAttempt(request.resource.data);

        allow delete: if isValidId(userId) && isOwner(userId);
      }
    }

    // Public / Protected Leaderboard collection
    match /leaderboard/{entryId} {
      allow get, list: if resource.data.hidden == false || (isSignedIn() && resource.data.uid == request.auth.uid);

      allow create: if isSignedIn() &&
                       isNotBlocked(request.auth.uid) &&
                       request.resource.data.uid == request.auth.uid &&
                       isValidLeaderboard(request.resource.data);

      // Immutable & undeletable by clients
      allow update, delete: if false;
    }

    // Word Association Test Word Bank
    match /watWords/{wordId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isAdmin() && isValidWatWord(request.resource.data);
      allow delete: if isSignedIn() && isAdmin();
    }
  }
}
